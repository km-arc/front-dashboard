{
  "name": "front-dashboard",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:repo": "node scripts/check-repo.mjs",
    "test:scripts": "node --test scripts/check-repo.test.mjs",
    "verify": "pnpm check:repo && pnpm test:scripts && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "prepare": "git config core.hooksPath .githooks || true",
    "build:ci": "NEXT_PUBLIC_API_MOCKING= API_BASE_URL= pnpm exec turbo run build --force"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.3.0",
    "typescript": "^5.6.3"
  }
}

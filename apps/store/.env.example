# Locale used for "/" when the visitor has no cookie or Accept-Language match: en | fa (default: en)
NEXT_PUBLIC_DEFAULT_LOCALE=
# IANA time zone used to format dates (default: Asia/Tehran)
NEXT_PUBLIC_TIME_ZONE=
# Base URL of the backend API, read on the server (leave empty until the backend exists)
API_BASE_URL=
# enabled = answer API calls from the built-in sample API, with no network; anything else uses API_BASE_URL
NEXT_PUBLIC_API_MOCKING=
# Dev only: hosts other than localhost that may open the dev server (a phone, another computer), comma separated.
# Example: ALLOWED_DEV_ORIGINS=192.168.1.6,192.168.1.7 (restart the dev server after changing it)
ALLOWED_DEV_ORIGINS=
